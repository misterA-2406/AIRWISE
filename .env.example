# AIRWISE Environment Configuration
# Copy to .env for local development. Never commit .env to version control.

ENVIRONMENT=development
DEBUG=false
HOST=127.0.0.1
PORT=8000

# Comma-separated allowed frontend origins for CORS
FRONTEND_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# Database URL (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./airwise.db

# Environmental Telemetry Providers (open_meteo requires no API key)
AIR_QUALITY_PROVIDER=open_meteo
WEATHER_PROVIDER=open_meteo

# GenAI Provider (Get a free Gemini API key at https://aistudio.google.com/apikey)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash

# Security (Generate a strong random key for production)
JWT_SECRET=
RATE_LIMIT_PER_MINUTE=60
