# AIRWISE Backend Environment Configuration

# Server
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=127.0.0.1
API_V1_STR=/api
FRONTEND_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# Database
DATABASE_URL=sqlite:///./airwise.db

# Environmental Data Providers
# Supported: open_meteo (free, no key required), waqi (World Air Quality Index), cpcb_mock
AIR_QUALITY_PROVIDER=open_meteo
AIR_QUALITY_API_KEY=
WEATHER_PROVIDER=open_meteo
WEATHER_API_KEY=

# AI Provider
# Supported: gemini, openai, mock
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Security & Limits
RATE_LIMIT_PER_MINUTE=60
JWT_SECRET=super-secret-climate-key-change-in-production
CACHE_TTL_AIR_QUALITY_SECONDS=600
CACHE_TTL_WEATHER_SECONDS=900
CACHE_TTL_FORECAST_SECONDS=1800
